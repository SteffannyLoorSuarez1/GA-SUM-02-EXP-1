<mxfile host="app.diagrams.net"><diagram id="ishikawa" name="Ishikawa Kodus 2026"><mxGraphModel dx="1400" dy="720" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="720" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" style="endArrow=block;endFill=1;html=1;strokeWidth=3;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="360" as="sourcePoint"/><mxPoint x="1090" y="360" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c4" value="&lt;b&gt;Revisiones lentas e inestables en Kodus&lt;/b&gt;&lt;br&gt;enero de 2026&lt;br&gt;(unos 900 pull requests en cola)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1090" y="300" width="260" height="120" as="geometry"/></mxCell><mxCell id="c5" style="endArrow=none;html=1;strokeWidth=2;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="110" as="sourcePoint"/><mxPoint x="580" y="360" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c6" value="Tecnología" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6E6E6;strokeColor=#000000;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="300" y="70" width="160" height="40" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;(F)&lt;/b&gt; Tres nodos de RabbitMQ sin formar clúster: unos saturados y otros sin trabajo" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=middle;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="116.0" y="150" width="250" height="60" as="geometry"/></mxCell><mxCell id="c8" style="endArrow=block;endFill=1;html=1;strokeWidth=1;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="371.0" y="180" as="sourcePoint"/><mxPoint x="436.0" y="180" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c9" value="&lt;b&gt;(F)&lt;/b&gt; Prefetch de 60 tareas con ack recién al terminar: muchas tareas pesadas en memoria" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=middle;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="172.0" y="220" width="250" height="60" as="geometry"/></mxCell><mxCell id="c10" style="endArrow=block;endFill=1;html=1;strokeWidth=1;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="427.0" y="250" as="sourcePoint"/><mxPoint x="492.0" y="250" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c11" style="endArrow=none;html=1;strokeWidth=2;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="820" y="110" as="sourcePoint"/><mxPoint x="1020" y="360" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c12" value="Procesos" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6E6E6;strokeColor=#000000;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="740" y="70" width="160" height="40" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;(F)&lt;/b&gt; Terraform omitió las IP privadas para que los nodos se descubrieran" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=middle;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="556.0" y="150" width="250" height="60" as="geometry"/></mxCell><mxCell id="c14" style="endArrow=block;endFill=1;html=1;strokeWidth=1;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="811.0" y="180" as="sourcePoint"/><mxPoint x="876.0" y="180" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c15" value="&lt;b&gt;(F)&lt;/b&gt; Tareas que reintentaban sin fallar rápido y bloqueaban la cola" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=middle;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="612.0" y="220" width="250" height="60" as="geometry"/></mxCell><mxCell id="c16" style="endArrow=block;endFill=1;html=1;strokeWidth=1;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="867.0" y="250" as="sourcePoint"/><mxPoint x="932.0" y="250" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c17" style="endArrow=none;html=1;strokeWidth=2;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="610" as="sourcePoint"/><mxPoint x="580" y="360" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c18" value="Entorno" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6E6E6;strokeColor=#000000;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="300" y="610" width="160" height="40" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;(D)&lt;/b&gt; Carga real de revisiones después de la migración del 4 de enero" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=middle;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="116.0" y="510" width="250" height="60" as="geometry"/></mxCell><mxCell id="c20" style="endArrow=block;endFill=1;html=1;strokeWidth=1;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="371.0" y="540" as="sourcePoint"/><mxPoint x="436.0" y="540" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c21" value="Límites de uso de la API de GitHub" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=middle;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="172.0" y="440" width="250" height="60" as="geometry"/></mxCell><mxCell id="c22" style="endArrow=block;endFill=1;html=1;strokeWidth=1;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="427.0" y="470" as="sourcePoint"/><mxPoint x="492.0" y="470" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c23" style="endArrow=none;html=1;strokeWidth=2;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="820" y="610" as="sourcePoint"/><mxPoint x="1020" y="360" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c24" value="Diseño del software" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6E6E6;strokeColor=#000000;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="740" y="610" width="160" height="40" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;(F)&lt;/b&gt; Consultas N+1 y 1 a 2 GB de RAM por revisión grande" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=middle;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="556.0" y="510" width="250" height="60" as="geometry"/></mxCell><mxCell id="c26" style="endArrow=block;endFill=1;html=1;strokeWidth=1;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="811.0" y="540" as="sourcePoint"/><mxPoint x="876.0" y="540" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c27" value="&lt;b&gt;(F)&lt;/b&gt; La cola funcionaba como compuerta de concurrencia, no como pipeline por etapas" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=middle;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="612.0" y="440" width="250" height="60" as="geometry"/></mxCell><mxCell id="c28" style="endArrow=block;endFill=1;html=1;strokeWidth=1;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="867.0" y="470" as="sourcePoint"/><mxPoint x="932.0" y="470" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c29" value="&lt;b&gt;(D)&lt;/b&gt; detonante &amp;nbsp;&amp;nbsp; &lt;b&gt;(F)&lt;/b&gt; causa de fondo &amp;nbsp;&amp;nbsp; Fuente: post-mortem de Kodus (Malinosqui, 2026)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="665" width="700" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>